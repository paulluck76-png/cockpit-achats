# Copie ce fichier en .env.local (local) et renseigne les mêmes variables dans Vercel.
# 100% gratuit : aucune carte bancaire requise.

# Clé API Google Gemini (gratuite) : https://aistudio.google.com/apikey
# Elle reste côté serveur, jamais exposée au navigateur.
GEMINI_API_KEY=AIza-xxxxxxxx

# Modèle Gemini gratuit avec recherche Google. Défaut : gemini-2.5-flash
# Alternatives si besoin : gemini-flash-latest, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Mot de passe pour entrer dans l'appli (choisis-le).
APP_PASSWORD=change-moi

# Secret de session (chaîne aléatoire longue, différente du mot de passe).
APP_SESSION_SECRET=colle-ici-une-longue-chaine-aleatoire
